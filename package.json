{
  "name": "field-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Geodesic-sphere simulation lab — v2 DSL, WebGPU compute pipeline, recipes corpus.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/copy-runtime-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test dsl/*_test.mjs kernel/*_test.mjs testing/*_test.mjs visual/*_test.mjs",
    "fuzz": "node testing/fuzz-v2.mjs",
    "fuzz:wgsl": "node testing/fuzz-v2.mjs --wgsl",
    "fuzz:execute": "node testing/fuzz-v2.mjs --execute",
    "fuzz:targeted": "node testing/targeted-fuzz-v2.mjs --wgsl",
    "fuzz:targeted:execute": "node testing/targeted-fuzz-v2.mjs --execute",
    "fuzz:negative": "node testing/negative-fuzz-v2.mjs",
    "fuzz:mutational": "node testing/mutational-fuzz-v2.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "webgpu": "^0.3.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.13.0",
    "@codemirror/commands": "^6.5.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.1",
    "@codemirror/lint": "^6.5.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@lezer/common": "^1.2.1",
    "@lezer/highlight": "^1.2.0",
    "@lezer/javascript": "^1.4.17",
    "@lezer/lr": "^1.4.2",
    "three": "^0.160.0"
  }
}
